# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_EMAIL=your_email@example.com

# Google OAuth (same client used for Supabase SSO)
# Find in Google Cloud Console → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Anthropic (Claude API)
# Find at console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google Gemini (wardrobe AI — vision + image generation)
# Find at aistudio.google.com → API Keys
GEMINI_API_KEY=your_gemini_api_key

# Finnhub (real-time stock prices)
# Find at finnhub.io → Dashboard → API Key
FINNHUB_API_KEY=your_finnhub_api_key
